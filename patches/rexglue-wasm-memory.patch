index 0000000..ed7b2ab
--- /dev/null
+++ b/include/rex/memory/wasm_fold.h
@@ -0,0 +1,65 @@
+/**
+ * @file        wasm_fold.h
+ * @brief       Guest->linear address folding for the WebAssembly (memory64) build
+ *
+ * Native builds alias several guest views onto one backing file with mmap
+ * (MAP_FIXED).  WebAssembly linear memory cannot alias pages, so instead every
+ * guest address is "folded" into one compact arena:
+ *
+ *   guest 0x00000000-0x7EFFFFFF  -> arena + a                (identity, sparse)
+ *   guest 0x7F000000-0x7FFFFFFF  -> arena + P + (a-0x7F000000)  (GPU writeback)
+ *   guest 0x80000000-0x8FFFFFFF  -> arena + a                (xex 64k pages)
+ *   guest 0x90000000-0x9FFFFFFF  -> arena + a - 0x10000000   (xex 4k alias of 0x8...)
+ *   guest 0xA0000000-0xBFFFFFFF  -> arena + P + (a-0xA0000000)
+ *   guest 0xC0000000-0xDFFFFFFF  -> arena + P + (a-0xC0000000)
+ *   guest 0xE0000000-0xFFFFFFFF  -> arena + P + 0x1000 + (a-0xE0000000)
+ *
+ * P (kPhysBase) is the 512 MB physical block.  Because every boundary is
+ * 16 MB aligned, the per-address delta is one load from a 256-entry table
+ * indexed by (a >> 24).  Recompiled code already adds REX_PHYS_HOST_OFFSET(x)
+ * to every access, so the table slots straight into that hook.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory::wasm {
+
+inline constexpr uint64_t kPhysBase = 0x90000000ull;
+inline constexpr uint64_t kPhysSize = 0x20000000ull;
+// +0x1000: the 0xE0000000 view is shifted by one 4 KB page.
+inline constexpr uint64_t kArenaSize = kPhysBase + kPhysSize + 0x1000ull;
+
+constexpr int64_t FoldDelta(uint32_t a) {
+  if (a < 0x7F000000u) return 0;
+  if (a < 0x80000000u) return int64_t(kPhysBase) - 0x7F000000ll;
+  if (a < 0x90000000u) return 0;
+  if (a < 0xA0000000u) return -0x10000000ll;
+  if (a < 0xC0000000u) return int64_t(kPhysBase) - 0xA0000000ll;
+  if (a < 0xE0000000u) return int64_t(kPhysBase) - 0xC0000000ll;
+  return int64_t(kPhysBase) + 0x1000ll - 0xE0000000ll;
+}
+
+struct FoldTable {
+  int64_t v[256];
+  constexpr FoldTable() : v() {
+    for (int i = 0; i < 256; ++i) v[i] = FoldDelta(uint32_t(i) << 24);
+  }
+};
+inline constexpr FoldTable kFoldTable{};
+
+/// Value to add to (base + guest_address) to reach the folded host address.
+inline int64_t HostDelta(uint32_t a) noexcept { return kFoldTable.v[a >> 24]; }
+/// Guest address -> offset from the arena base.
+inline int64_t Fold(uint32_t a) noexcept { return int64_t(a) + HostDelta(a); }
+
+/// Arena offset -> guest address (physical block is reported as a physical address,
+/// matching Memory::HostToGuestVirtual's truncation on native builds).
+inline uint32_t Unfold(uint64_t offset) noexcept {
+  return offset >= kPhysBase ? uint32_t(offset - kPhysBase) : uint32_t(offset);
+}
+
+/// Base of the arena (null until Memory::Initialize has created the mapping).
+uint8_t* ArenaBase();
+
+}  // namespace rex::memory::wasm
