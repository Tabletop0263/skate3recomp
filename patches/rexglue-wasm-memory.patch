--- /dev/null
+++ b/src/core/memory_wasm.cpp
@@ -0,0 +1,108 @@
+/**
+ * @brief  WebAssembly (Emscripten, memory64) replacement for memory_posix.cpp
+ *
+ * No mmap aliasing, no mprotect, no page faults in WebAssembly.  The whole guest
+ * address space lives in one arena carved out of linear memory with sbrk()
+ * (fresh wasm pages are zero and engines commit them lazily on first touch, so
+ * the 2.75 GB span only costs what the game actually touches).  Aliased guest
+ * views are resolved by address folding, see rex/memory/wasm_fold.h.
+ *
+ * Known gap: Protect() is a no-op, so write-watch callbacks driven by page
+ * faults (EnablePhysicalMemoryAccessCallbacks) never fire.  The GPU
+ * shared-memory path needs explicit dirty tracking.
+ */
+#ifdef __EMSCRIPTEN__
+
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include <rex/memory/utils.h>
+#include <rex/memory/wasm_fold.h>
+
+namespace rex {
+namespace memory {
+
+namespace {
+uint8_t* g_arena = nullptr;
+bool g_arena_used = false;
+
+bool InArena(const void* p, size_t length) {
+  auto a = reinterpret_cast<uintptr_t>(g_arena);
+  auto x = reinterpret_cast<uintptr_t>(p);
+  return g_arena && x >= a && x + length <= a + wasm::kArenaSize;
+}
+}  // namespace
+
+namespace wasm {
+uint8_t* ArenaBase() { return g_arena; }
+}  // namespace wasm
+
+size_t page_size() { return 4096; }
+// 4 KB on purpose: the 0xE0000000 +0x1000 shift is handled by the fold table.
+size_t allocation_granularity() { return 4096; }
+
+void* AllocFixed(void* base_address, size_t length, AllocationType, PageAccess) {
+  if (!base_address) {
+    void* p = nullptr;
+    if (posix_memalign(&p, 4096, length) != 0) return nullptr;
+    std::memset(p, 0, length);
+    return p;
+  }
+  // Reserve/commit inside the pre-zeroed arena are no-ops.
+  return InArena(base_address, length) ? base_address : nullptr;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType type) {
+  if (!InArena(base_address, length ? length : 1)) {
+    if (type == DeallocationType::kRelease) { std::free(base_address); return true; }
+    return false;
+  }
+  // Guests expect zero-filled pages on re-commit; MADV_DONTNEED does not exist
+  // here, so clear explicitly.  (length==0 on release means "whole region",
+  // which the heap code zero-initialises again on reuse.)
+  if (length) std::memset(base_address, 0, length);
+  return true;
+}
+
+bool Protect(void*, size_t, PageAccess, PageAccess* out_old_access) {
+  if (out_old_access) *out_old_access = PageAccess::kReadWrite;
+  return true;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  if (!InArena(base_address, 1)) { length = 0; access_out = PageAccess::kNoAccess; return false; }
+  length = reinterpret_cast<uintptr_t>(g_arena) + wasm::kArenaSize -
+           reinterpret_cast<uintptr_t>(base_address);
+  access_out = PageAccess::kReadWrite;
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path&, size_t, PageAccess, bool) {
+  if (!g_arena) {
+    constexpr uintptr_t kAlign = 65536;
+    void* p = sbrk(static_cast<intptr_t>(wasm::kArenaSize + kAlign));
+    if (p == reinterpret_cast<void*>(-1)) return kFileMappingHandleInvalid;
+    g_arena = reinterpret_cast<uint8_t*>((reinterpret_cast<uintptr_t>(p) + kAlign - 1) & ~(kAlign - 1));
+  } else if (g_arena_used) {
+    std::memset(g_arena, 0, wasm::kArenaSize);  // re-initialisation: hand back a clean arena
+  }
+  g_arena_used = true;
+  return 1;
+}
+
+void CloseFileMappingHandle(FileMappingHandle, const std::filesystem::path&) {}
+
+// Views are resolved by folding in Memory::Initialize; these are only reached
+// through the generic code paths and are identity/no-ops here.
+void* MapFileView(FileMappingHandle, void* base_address, size_t, PageAccess, size_t) {
+  return base_address;
+}
+bool UnmapFileView(FileMappingHandle, void*, size_t) { return true; }
+
+}  // namespace memory
+}  // namespace rex
+
+#endif  // __EMSCRIPTEN__
