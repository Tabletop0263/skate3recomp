 namespace rex::kernel::crt {
 
 void* ReXHeap::GuestToHost(uint32_t guest_addr) const {
+#if defined(__EMSCRIPTEN__)
+  return membase_ + rex::memory::wasm::Fold(guest_addr);
+#else
   return membase_ + guest_addr;
+#endif
 }
 
 uint32_t ReXHeap::HostToGuest(void* host_ptr) const {
+#if defined(__EMSCRIPTEN__)
+  return rex::memory::wasm::Unfold(static_cast<uint8_t*>(host_ptr) - membase_);
+#else
   return static_cast<uint32_t>(static_cast<uint8_t*>(host_ptr) - membase_);
+#endif
 }
 
 bool ReXHeap::InHeap(uint32_t guest_addr) const {
diff --git a/src/system/xmemory.cpp b/src/system/xmemory.cpp
index 0c542aa..87771d8 100644
--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -173,6 +173,18 @@ bool Memory::Initialize() {
   // Attempt to create our views. This may fail at the first address
   // we pick, so try a few times.
   mapping_base_ = 0;
+#if defined(__EMSCRIPTEN__)
+  // One arena, aliased views resolved by folding (see rex/memory/wasm_fold.h).
+  if (uint8_t* arena = rex::memory::wasm::ArenaBase()) {
+    for (size_t n = 0; n < rex::countof(map_info); n++) {
+      const uint64_t start = map_info[n].virtual_address_start;
+      views_.all_views[n] = arena + (start >= 0x100000000ull
+                                         ? rex::memory::wasm::kPhysBase
+                                         : uint64_t(rex::memory::wasm::Fold(uint32_t(start))));
+    }
+    mapping_base_ = arena;
+  }
+#else
   for (size_t n = 32; n < 64; n++) {
     auto mapping_base = reinterpret_cast<uint8_t*>(1ull << n);
     if (!MapViews(mapping_base)) {
@@ -187,13 +199,18 @@ bool Memory::Initialize() {
     }
   }
 #endif
+#endif  // __EMSCRIPTEN__
   if (!mapping_base_) {
     REXSYS_ERROR("Unable to find a continuous block in the 64bit address space.");
     assert_always();
     return false;
   }
   virtual_membase_ = mapping_base_;
+#if defined(__EMSCRIPTEN__)
+  physical_membase_ = mapping_base_ + rex::memory::wasm::kPhysBase;
+#else
   physical_membase_ = mapping_base_ + 0x100000000ull;
+#endif
   // Prepare virtual heaps.
   heaps_.v00000000.Initialize(this, virtual_membase_, memory::HeapType::kGuestVirtual, 0x00000000,
                               0x40000000, 4096);
@@ -248,7 +265,11 @@ bool Memory::Initialize() {
   // The 0x7F000000-0x7FFFFFFF view aliases the start of physical memory. Touch
   // it explicitly on macOS so raw generated loads through this alias don't SIGBUS
   // before any guest write has materialized the shared-memory pages.
+#if defined(__EMSCRIPTEN__)
+  std::memset(virtual_membase_ + rex::memory::wasm::Fold(0x7F000000u), 0, 0x01000000);
+#else
   std::memset(virtual_membase_ + 0x7F000000, 0, 0x01000000);
+#endif
 #endif
 
   // Install MMIO handler for physical address translation and MMIO ranges
@@ -453,6 +474,10 @@ VirtualHeap* Memory::GetPhysicalHeap() {
 }
 
 uint32_t Memory::HostToGuestVirtual(const void* host_address) const {
+#if defined(__EMSCRIPTEN__)
+  return rex::memory::wasm::Unfold(reinterpret_cast<size_t>(host_address) -
+                                   reinterpret_cast<size_t>(virtual_membase_));
+#endif
   size_t virtual_address =
       reinterpret_cast<size_t>(host_address) - reinterpret_cast<size_t>(virtual_membase_);
   uint32_t vE0000000_host_offset = heaps_.vE0000000.host_address_offset();
@@ -918,6 +943,9 @@ void BaseHeap::Initialize(memory::Memory* memory, uint8_t* membase, HeapType hea
   assert_true(rex::is_pow2(page_size_));
   page_size_shift_ = rex::log2_floor(page_size_);
   host_address_offset_ = host_address_offset;
+#if defined(__EMSCRIPTEN__)
+  folds_ = (membase_ == memory->virtual_membase());
+#endif
   page_table_.resize(heap_size / page_size);
   unreserved_page_count_ = uint32_t(page_table_.size());
 }
